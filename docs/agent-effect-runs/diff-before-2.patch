+
+class TestCollectionPrompts:
+    """Tests for GET /collections/{collection_id}/prompts."""
+
+    def test_lists_only_prompts_in_collection(
+        self, client: TestClient, sample_collection_data, sample_prompt_data
+    ):
+        """Verify the endpoint returns the collection's prompts and no others.
+
+        One prompt is filed in a second collection and one is unfiled, so a
+        handler that ignored the path parameter would return all three.
+
+        Args:
+            client: FastAPI test client fixture.
+            sample_collection_data: Valid collection payload fixture.
+            sample_prompt_data: Valid prompt payload fixture.
+        """
+        target_id = client.post("/collections", json=sample_collection_data).json()["id"]
+        other_id = client.post("/collections", json={"name": "Other"}).json()["id"]
+
+        filed = client.post(
+            "/prompts", json={**sample_prompt_data, "collection_id": target_id}
+        ).json()
+        client.post("/prompts", json={**sample_prompt_data, "collection_id": other_id})
+        client.post("/prompts", json=sample_prompt_data)
+
+        response = client.get(f"/collections/{target_id}/prompts")
+        assert response.status_code == 200
+        data = response.json()
+        assert data["total"] == 1
+        assert [p["id"] for p in data["prompts"]] == [filed["id"]]
+
+    def test_sorted_newest_first(self, client: TestClient, sample_collection_data):
+        """Verify the prompts come back newest first, as GET /prompts does.
+
+        The sleep keeps the creation timestamps distinct; with equal ones the
+        stable sort would keep creation order and the test would fail at random.
+
+        Args:
+            client: FastAPI test client fixture.
+            sample_collection_data: Valid collection payload fixture.
+        """
+        import time
+
+        collection_id = client.post(
+            "/collections", json=sample_collection_data
+        ).json()["id"]
+        for title in ["First", "Second", "Third"]:
+            time.sleep(0.01)
+            client.post(
+                "/prompts",
+                json={
+                    "title": title,
+                    "content": f"{title} prompt content",
+                    "collection_id": collection_id,
+                },
+            )
+
+        prompts = client.get(f"/collections/{collection_id}/prompts").json()["prompts"]
+        assert [p["title"] for p in prompts] == ["Third", "Second", "First"]
+
+    def test_empty_collection(self, client: TestClient, sample_collection_data):
+        """Verify an existing collection with no prompts gives an empty list.
+
+        Args:
+            client: FastAPI test client fixture.
+            sample_collection_data: Valid collection payload fixture.
+        """
+        collection_id = client.post(
+            "/collections", json=sample_collection_data
+        ).json()["id"]
+
+        response = client.get(f"/collections/{collection_id}/prompts")
+        assert response.status_code == 200
+        assert response.json() == {"prompts": [], "total": 0}
+
+    def test_collection_not_found(self, client: TestClient):
+        """Verify an unknown collection is a 404, not an empty list.
+
+        Args:
+            client: FastAPI test client fixture.
+        """
+        response = client.get("/collections/nonexistent-id/prompts")
+        assert response.status_code == 404
+        assert response.json() == {"detail": "Collection not found"}
+
+    def test_deleted_collection_not_found(
+        self, client: TestClient, sample_collection_data, sample_prompt_data
+    ):
+        """Verify a deleted collection is a 404 even though it once had prompts.
+
+        Args:
+            client: FastAPI test client fixture.
+            sample_collection_data: Valid collection payload fixture.
+            sample_prompt_data: Valid prompt payload fixture.
+        """
+        collection_id = client.post(
+            "/collections", json=sample_collection_data
+        ).json()["id"]
+        client.post("/prompts", json={**sample_prompt_data, "collection_id": collection_id})
+        client.delete(f"/collections/{collection_id}")
+
+        assert client.get(f"/collections/{collection_id}/prompts").status_code == 404
