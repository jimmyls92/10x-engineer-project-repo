+@app.get("/collections/{collection_id}/prompts", response_model=PromptList)
+def list_collection_prompts(collection_id: str):
+    """List the prompts filed in one collection, newest first.
+
+    Unlike ``GET /prompts?collection_id=<id>``, which gives an empty list for
+    an unknown collection, this endpoint checks that the collection exists,
+    so an empty list always means an existing collection with no prompts.
+
+    Args:
+        collection_id: Identifier of the collection whose prompts to list.
+
+    Returns:
+        A ``PromptList`` holding the collection's prompts and their count.
+
+    Raises:
+        HTTPException: With status 404 if no collection has that identifier.
+    """
+    if not storage.get_collection(collection_id):
+        raise HTTPException(status_code=404, detail="Collection not found")
+
+    prompts = storage.get_prompts_by_collection(collection_id)
+    prompts = sort_prompts_by_date(prompts, descending=True)
+
+    return PromptList(prompts=prompts, total=len(prompts))
+
