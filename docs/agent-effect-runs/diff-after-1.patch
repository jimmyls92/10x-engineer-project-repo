+    def test_list_collection_prompts_success(
+        self, client: TestClient, sample_collection_data, sample_prompt_data
+    ):
+        """Verify the endpoint returns only the collection's prompts, newest first.
+
+        A prompt in another collection and an unfiled prompt are created too,
+        so the test fails if the endpoint returns more than the one collection.
+
+        Args:
+            client: FastAPI test client fixture.
+            sample_collection_data: Valid collection payload fixture.
+            sample_prompt_data: Valid prompt payload fixture.
+        """
+        collection_id = client.post(
+            "/collections", json=sample_collection_data
+        ).json()["id"]
+        other_id = client.post(
+            "/collections", json={**sample_collection_data, "name": "Other"}
+        ).json()["id"]
+
+        first = client.post(
+            "/prompts",
+            json={**sample_prompt_data, "title": "First", "collection_id": collection_id},
+        ).json()
+        second = client.post(
+            "/prompts",
+            json={**sample_prompt_data, "title": "Second", "collection_id": collection_id},
+        ).json()
+        client.post("/prompts", json={**sample_prompt_data, "collection_id": other_id})
+        client.post("/prompts", json=sample_prompt_data)
+
+        response = client.get(f"/collections/{collection_id}/prompts")
+        assert response.status_code == 200
+        data = response.json()
+
+        assert data["total"] == 2
+        assert [p["id"] for p in data["prompts"]] == [second["id"], first["id"]]
+        created = [datetime.fromisoformat(p["created_at"]) for p in data["prompts"]]
+        assert created[0] > created[1]
+
