+    def test_list_collection_prompts(
+        self, client: TestClient, sample_collection_data, sample_prompt_data
+    ):
+        """Verify GET /collections/{id}/prompts returns only that collection's prompts.
+
+        A second collection and an unfiled prompt are created alongside, so the
+        test fails if the endpoint returns everything rather than filtering.
+        The two filed prompts must come back newest first.
+
+        Args:
+            client: FastAPI test client fixture.
+            sample_collection_data: Valid collection payload fixture.
+            sample_prompt_data: Valid prompt payload fixture.
+        """
+        collection_id = client.post(
+            "/collections", json=sample_collection_data
+        ).json()["id"]
+        other_id = client.post(
+            "/collections", json={"name": "Other collection"}
+        ).json()["id"]
+
+        first = client.post(
+            "/prompts",
+            json={**sample_prompt_data, "title": "First", "collection_id": collection_id},
+        ).json()
+        second = client.post(
+            "/prompts",
+            json={**sample_prompt_data, "title": "Second", "collection_id": collection_id},
+        ).json()
+        client.post("/prompts", json={**sample_prompt_data, "collection_id": other_id})
+        client.post("/prompts", json=sample_prompt_data)
+
+        response = client.get(f"/collections/{collection_id}/prompts")
+        assert response.status_code == 200
+        data = response.json()
+        assert data["total"] == 2
+        assert [p["id"] for p in data["prompts"]] == [second["id"], first["id"]]
+
+    def test_list_collection_prompts_empty(
+        self, client: TestClient, sample_collection_data, sample_prompt_data
+    ):
+        """Verify an existing collection with no prompts gives an empty list, not 404.
+
+        Args:
+            client: FastAPI test client fixture.
+            sample_collection_data: Valid collection payload fixture.
+            sample_prompt_data: Valid prompt payload fixture.
+        """
+        collection_id = client.post(
+            "/collections", json=sample_collection_data
+        ).json()["id"]
+        client.post("/prompts", json=sample_prompt_data)
+
+        response = client.get(f"/collections/{collection_id}/prompts")
+        assert response.status_code == 200
+        assert response.json() == {"prompts": [], "total": 0}
+
+    def test_list_collection_prompts_not_found(self, client: TestClient):
+        """Verify an unknown collection id is a 404 rather than an empty list.
+
+        Args:
+            client: FastAPI test client fixture.
+        """
+        response = client.get("/collections/nonexistent-id/prompts")
+        assert response.status_code == 404
+        assert response.json() == {"detail": "Collection not found"}
+
+    def test_list_collection_prompts_after_collection_deleted(
+        self, client: TestClient, sample_collection_data, sample_prompt_data
+    ):
+        """Verify a deleted collection's prompts are no longer listed under it.
+
+        Args:
+            client: FastAPI test client fixture.
+            sample_collection_data: Valid collection payload fixture.
+            sample_prompt_data: Valid prompt payload fixture.
+        """
+        collection_id = client.post(
+            "/collections", json=sample_collection_data
+        ).json()["id"]
+        client.post("/prompts", json={**sample_prompt_data, "collection_id": collection_id})
+
+        client.delete(f"/collections/{collection_id}")
+
+        response = client.get(f"/collections/{collection_id}/prompts")
+        assert response.status_code == 404
